DATABASE_URL=postgresql+pg8000://nexstudio:nexstudio@localhost:9178/nexstudio
TEST_DATABASE_URL=postgresql+pg8000://nexstudio:nexstudio@localhost:9178/nexstudio_test
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_PORT=9176
FRONTEND_PORT=9177
VITE_API_BASE_URL=http://localhost:9176

# GitHub integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
# gh CLI auth — used by Implementer (AgentTerminal) for `gh run watch` / `gh api`
# per charter §15.3 (CR-NS-002). Same PAT as GITHUB_TOKEN typically; gh prefers
# GH_TOKEN env name. Empty default is acceptable in docker-compose passthrough.
GH_TOKEN=ghp_your_github_personal_access_token

# Claude CLI configuration
CLAUDE_CONFIG_DIR=/root/.claude
CLAUDE_CLI_PATH=claude

# Dedo's machine identity (ICCINT-14, charter §4.5) — opens /api/v1/dedo/* and NOTHING else.
#
# WHAT GOES HERE IS THE DIGEST, NOT THE TOKEN. This container also runs the AI Agent (claude, root,
# unrestricted Bash), so whatever the container holds the agent can read — and the agent is exactly
# who this boundary binds: it raises the framework_issue blocks Dedo's token clears. The server only
# needs to RECOGNISE the token, so it stores a SHA-256 digest, which nobody can replay.
#
#   1) Dedo generates the token ONCE, on his own machine, and keeps it there:
#          openssl rand -hex 32                     # this is the token — it never lands on the server
#   2) the digest goes into the deployment:
#          printf %s "<token>" | sha256sum          # 64 hex chars — this is what the server gets
#
# Empty (the default) means Dedo's door is CLOSED — every request to it answers 503 — which is the
# intended state until the digest is placed. Never a user JWT, never committed.
DEDO_API_TOKEN_SHA256=

# WHERE TO PUT IT FOR THE RUNNING INSTANCE — this file is NOT it. The repo docker-compose.yml is the
# dev stack; the PROD Visual instance (v4, ports 9216/9217) runs from
#   /opt/customers/dev/nex-studio-visual/docker-compose.yml   (+ the .env beside it)
# which is hand-maintained and inherits nothing from this repository. Verify before assuming:
#   docker inspect nex-studio-visual-prod-backend-1 \
#     --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}'
# Opening Dedo's door there means adding the passthrough line to THAT compose file's backend
# environment: block plus the value in the .env beside it, then restarting the backend. Until that is
# done, Dedo's door on the PROD instance answers 503 no matter what this repository contains.
#
# DEDO_API_TOKEN (the plaintext secret) is still read, for local development only. It is popped from
# os.environ at startup and withheld from every agent spawn, but it cannot be hidden from a root shell
# reading /proc/1/environ inside the container — so it must not be used where agents build.
DEDO_API_TOKEN=
